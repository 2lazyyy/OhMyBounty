{
  "engagements": [
    {
      "name": "NASA VDP",
      "engagementCode": "nasa-vdp",
      "enabled": true,
      "platform": "bugcrowd",
      "targets": [
        {
          "name": "NASA main domain",
          "domains": [
            "nasa.gov",
            "usgeo.gov",
            "globe.gov"
          ]
        }
      ],
      "announcements": {
        "enabled": true,
        "lastAnnouncementId": "7bd8df56-e8e0-4110-b046-13ad269d2c8a"
      },
      "crowdStream": {
        "enabled": true,
        "minimumPriorityNumber": 3,
        "filterBy": [
          "disclosures"
        ],
        "lastReportId": "73b8d47e-1e1c-444c-9281-b064377e967f"
      },
      "subdomainMonitor": {
        "enabled": true,
        "storeMode": false,
        "runTools": true,
        "subdomainsDirectory": "/app/subdomains/nasa-vdp"
      },
      "jsRecon": {
        "enabled": true,
        "scanOnNewSubdomain": true,
        "scanTimeoutSeconds": 15,
        "crawlDepth": 3,
        "secretFinderEnabled": true,
        "linkFinderEnabled": true,
        "toolTimeoutSeconds": 30
      }
    }
  ],
  "cronInterval": "*/15 * * * *",
  "notifications": {
    "telegram": true,
    "discord": true
  }
}