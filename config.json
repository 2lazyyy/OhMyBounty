{
  "engagements": [
    {
      "name": "NASA VDP",
      "engagementCode": "nasa-vdp",
      "enabled": true,
      "platform": "bugcrowd",
      "targets": [
        {
          "name": "NASA main domain",
          "domains": [
            "nasa.gov",
            "usgeo.gov",
            "globe.gov"
          ]
        }
      ],
      "announcements": {
        "enabled": true,
        "lastAnnouncementId": "7bd8df56-e8e0-4110-b046-13ad269d2c8a"
      },
      "crowdStream": {
        "enabled": true,
        "minimumPriorityNumber": 3,
        "filterBy": [
          "disclosures",
          "accepted"
        ],
        "lastReportId": "41d2d9d1-056d-453b-b8cb-89b1f53c72f4"
      },
      "subdomainMonitor": {
        "enabled": true,
        "storeMode": true,
        "runTools": true,
        "tools": [
          "subfinder -d {domain} -all -silent -o {output}/{domain}-subfinder.txt",
          "amass enum -passive -d {domain} -o {output}/{domain}-amass.txt",
          "sublist3r -d {domain} -o {output}/{domain}-sublist3r_raw.txt",
          "curl -s \"https://crt.sh/?q=%25.{domain}&output=json\" | jq -r '.[].name_value' | sed 's/^\\*\\.//g' | sort -u > {output}/{domain}-crtsh.txt"
        ],
        "subdomainsDirectory": "/app/subdomains/nasa-vdp",
        "screenshotEnabled": true,
        "hideCodes": [
          404,
          403,
          500,
          401,
          503
        ]
      },
      "jsRecon": {
        "enabled": true,
        "scanOnNewSubdomain": true,
        "scanTimeoutSeconds": 15
      }
    }
  ],
  "cronInterval": "*/15 * * * *",
  "notifications": {
    "telegram": true,
    "discord": false
  }
}